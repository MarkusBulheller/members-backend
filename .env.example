DATABASE_URL=postgres://w2w:w2w_dev@localhost:5432/w2w_members
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=w2w_session
PORT=3001
NODE_ENV=development

# Origin of the members-portal frontend (not the public marketing site).
# Must be 127.0.0.1, not localhost — matches the iRacing OAuth client's registered redirect_uri.
CORS_ORIGIN=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000

# Origin of the separate, anonymous public marketing site — only needed so it can call the
# unguarded GET /stats/public-summary endpoint (real team totals, no PII) from its own origin.
# Optional: if unset, that endpoint just isn't reachable cross-origin from the marketing site.
PUBLIC_SITE_ORIGIN=http://localhost:5173

# Discord Application — https://discord.com/developers/applications
# Create an app, add an OAuth2 redirect matching DISCORD_REDIRECT_URI below.
# Must be 127.0.0.1, not localhost — see the CORS_ORIGIN comment above; the frontend and
# backend need to be the same "site" for the session cookie (SameSite=Lax) to be sent.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/auth/discord/callback

# Right-click your team's Discord server icon -> Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=

# Discord bot — posts an announcement (Components V2 message) when an event is published.
# Separate from the OAuth app above: needs a real Bot Token (Developer Portal -> your app ->
# Bot -> Reset Token), and the bot must be invited to the guild (OAuth2 URL Generator, scopes
# "bot", permission "Send Messages") and have that permission in the target channel.
# Right-click the channel -> Copy Channel ID.
DISCORD_BOT_TOKEN=
DISCORD_EVENTS_CHANNEL_ID=

# iRacing OAuth ("single page app" client — PKCE, no client secret). redirect_uri here must be
# the FRONTEND's callback route (where iRacing actually redirects the user's browser to), not
# this backend — the backend only does the server-to-server token exchange.
IRACING_CLIENT_ID=
IRACING_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/iracing
# Best-guess CDN base for car images returned by the Data API — not confirmed yet, check the
# raw `small_image`/`logo` paths in the iracing_cars table after a sync and adjust if broken.
IRACING_IMAGE_BASE_URL=https://images-static.iracing.com
